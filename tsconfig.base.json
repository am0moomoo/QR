{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@qr/ui": ["packages/ui/src/index.ts"],
      "@qr/ui/*": ["packages/ui/src/*"],
      "@qr/types": ["packages/types/src/index.ts"],
      "@qr/types/*": ["packages/types/src/*"]
    }
  }
}
