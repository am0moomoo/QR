{
  "name": "@qr/api",
  "private": true,
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "dev:worker": "ts-node -r tsconfig-paths/register src/worker.ts",
    "build": "nest build",
    "start": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/api/src/worker.js",
    "lint": "tsc --noEmit",
    "storage:cleanup": "tsx src/storage-maintenance.ts",
    "storage:cleanup:dry-run": "tsx src/storage-maintenance.ts --dry-run",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --require ts-node/register src/app.spec.ts",
    "test:integration": "node --test --test-force-exit --require ts-node/register src/integration/app.integration.spec.ts",
    "test:integration:queue-runtime": "node --test --test-force-exit --require ts-node/register src/integration/queue-runtime.spec.ts",
    "test:integration:real-bucket": "node --test --test-force-exit --require ts-node/register src/integration/real-bucket.spec.ts",
    "test": "pnpm run test:unit && pnpm run test:integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "@aws-sdk/s3-request-presigner": "^3.1029.0",
    "@nestjs/common": "^11.0.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.6",
    "@nestjs/platform-express": "^11.0.6",
    "@nestjs/swagger": "^11.1.2",
    "@prisma/client": "^6.6.0",
    "@qr/types": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.73.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.8.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^18.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.4",
    "@nestjs/testing": "^11.0.6",
    "@types/express": "^5.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
