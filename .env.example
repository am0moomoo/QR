# General
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_PORT=4000
SHORT_DOMAIN=http://localhost:4000
JWT_SECRET=change-me
SESSION_TTL_HOURS=720
IP_HASH_SALT=change-me
RESET_TOKEN_TTL_MINUTES=30
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# Database / cache
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qrflow?schema=public
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=qrflow
QUEUE_DRIVER=auto
QUEUE_PREFIX=qrflow
QUEUE_ROLE=both
SCAN_RATE_LIMIT_WINDOW_SECONDS=60
SCAN_RATE_LIMIT_MAX_REQUESTS=120
SCAN_WRITE_SYNC=false

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_SIGNED_URL_TTL_SECONDS=300
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=qrflow
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false

# Stripe
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
STRIPE_PRICE_LITE=price_lite_test
STRIPE_PRICE_PREMIUM=price_premium_test

# Email
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=replace-me

# Safety / webhooks
WEBHOOK_SIGNING_SECRET=replace-me
SAFETY_CHECK_PROVIDER=none
