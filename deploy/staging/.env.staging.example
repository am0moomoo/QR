APP_URL=https://staging.example.com
NEXT_PUBLIC_APP_URL=https://staging.example.com
API_URL=https://api-staging.example.com
NEXT_PUBLIC_API_URL=https://api-staging.example.com/api/v1
API_PORT=4000
SHORT_DOMAIN=https://api-staging.example.com

POSTGRES_DB=qrflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/qrflow?schema=public
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=qrflow-staging

QUEUE_DRIVER=bullmq
QUEUE_PREFIX=qrflow-staging
QUEUE_ROLE=producer

JWT_SECRET=replace-me
SESSION_TTL_HOURS=720
IP_HASH_SALT=replace-me
RESET_TOKEN_TTL_MINUTES=30
SCAN_RATE_LIMIT_WINDOW_SECONDS=60
SCAN_RATE_LIMIT_MAX_REQUESTS=120
SCAN_WRITE_SYNC=true

STORAGE_DRIVER=s3
STORAGE_SIGNED_URL_TTL_SECONDS=300
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=qrflow-staging
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

STRIPE_SECRET_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me
STRIPE_PRICE_LITE=price_xxx
STRIPE_PRICE_PREMIUM=price_xxx

EMAIL_FROM=noreply@example.com
RESEND_API_KEY=replace-me

WEBHOOK_SIGNING_SECRET=replace-me
SAFETY_CHECK_PROVIDER=none
